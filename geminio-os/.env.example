# Geminio OS safe environment template
# Copy to .env locally and fill values from your approved secret manager.
NODE_ENV=development
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/geminio_os
JWT_SECRET=replace-with-a-long-random-development-secret
VITE_APP_ID=replace-with-app-id
OAUTH_SERVER_URL=https://api.manus.im
OWNER_OPEN_ID=replace-with-owner-open-id
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=replace-with-development-key
# Optional, only when the corresponding provider is configured:
ALLOWED_ORIGINS=http://localhost:8081
RUNNER_PROVIDER=unavailable
RUNNER_EXTERNAL_ENDPOINT=
RUNNER_EXTERNAL_TOKEN=

# --- Development preview (developer machines only; never enable in production) ---
# GEMINIO_DEV_PREVIEW=1                     # enables /dev-preview supervisor (admin only, ignored when NODE_ENV=production)
# GEMINIO_DEV_PREVIEW_PUBLIC_URL=           # externally reachable URL of the Expo web dev server, if not localhost
# EXPO_PORT=8081

# ---- Home Universal AI Chat ----
# Web search (Home chat answers about current events). Without a key the UI says search is unavailable.
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_API_KEY=
# Speech-to-text (OpenAI-compatible /v1/audio/transcriptions). Falls back to BUILT_IN_FORGE_API_URL/KEY.
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# Model selection (no model names are hard-coded). Resolution: AI_MODEL_<CAPABILITY> > AI_MODEL_LEVEL_<LEVEL> > AI_MODEL_DEFAULT
AI_MODEL_DEFAULT=
# Credit prices (PLACEHOLDER defaults live in server/credits/ledger.ts; set real prices here). Example:
# CREDIT_PRICE_CONVERSATION_REPLY=1

# Sandboxed code execution from Home chat (requires an isolated sandbox service implementing the contract in server/home-chat/code-run.ts).
# Without these the "Run" button truthfully reports that execution is unavailable; code is never run on the app server.
GEMINIO_SANDBOX_URL=
GEMINIO_SANDBOX_KEY=
# Credits
# CREDITS_ENFORCEMENT=off   # dev/preview only; ignored in production
# AI_PAUSE_MAX_HOURS=24     # paused tasks are auto-cancelled after this
# AI_STEP_TIMEOUT_MS=120000
